diff --git a/src/components/Modal/schema/profileSettingSchema.ts b/src/components/Modal/schema/profileSettingSchema.ts
new file mode 100644
index 0000000..7228c7f
--- /dev/null
+++ b/src/components/Modal/schema/profileSettingSchema.ts
@@ -0,0 +1,16 @@
+import { z } from "zod";
+
+const NICKNAME_PATTERN =
+  /^[0-9A-Za-z가-힣ᄀ-ᇿ㄰-㆏]+$/u;
+const NICKNAME_MESSAGE = "*10자 이내의 한글, 숫자, 영문자를 입력해주세요.";
+
+export const profileSettingSchema = z.object({
+  nickname: z
+    .string()
+    .min(1, "닉네임을 입력해주세요.")
+    .max(10, NICKNAME_MESSAGE)
+    .regex(NICKNAME_PATTERN, NICKNAME_MESSAGE),
+  profileImage: z.string().min(1, "프로필 이미지를 선택해주세요."),
+});
+
+export type ProfileSettingFormData = z.infer<typeof profileSettingSchema>;
